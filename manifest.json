{
  "manifest_version": 3,
  "name": "GitHub PR Tracker",
  "version": "1.3.0",
  "description": "Track your open GitHub pull requests: approved, awaiting response, with comments, and recently merged.",
  "permissions": ["storage", "alarms", "cookies", "scripting", "notifications"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub PR Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
